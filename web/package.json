{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "tokens": "python3 scripts/gen_tokens.py",
    "tokens:check": "python3 scripts/gen_tokens.py --check",
    "e2e": "node scripts/e2e.mjs",
    "test:media": "node scripts/media-test.mjs",
    "verify": "npm run typecheck && npm run tokens:check && npm run e2e && npm run test:media"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
