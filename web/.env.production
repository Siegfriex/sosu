# Tracked production build config (Vercel project `sosu`, Root Directory web). Vercel env vars cannot be set for this
# project, so the production API origin lives here. Vite loads this file only for `vite build` (mode=production), and
# real process env always wins: e.g. the integration e2e builds with VITE_API_BASE_URL=http://127.0.0.1:8000 and the
# legacy e2e with VITE_API_MODE=mock. Never put secrets in VITE_* variables — they are inlined into the public bundle.
VITE_API_MODE=http
VITE_API_BASE_URL=https://sosu-py.vercel.app
