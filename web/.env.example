# Copy to .env.local (not committed) to override. Build-time (Vite) variables.
# http (default when unset): call the real SOSU FastAPI service. mock: in-browser mock data (legacy e2e / design QA only).
# An HTTP failure never falls back to mock data.
VITE_API_MODE=http
# FastAPI origin (must be in the backend's SOSU_CORS_ORIGINS).
VITE_API_BASE_URL=http://127.0.0.1:8000
